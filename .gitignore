# Heavy data files (root-anchored so it cannot swallow e.g. src/vcm/data/)
/data/
/data/**/*
*.tar
*.tar.gz
*.gz
*.zip
*.csv
*.xlsx
*.xls
*.h5ad
*.parquet
*.CEL
*.cel

# Claude worktrees (copies of all data)
.claude/
.claude/**/*

# Output files (root-anchored - same reason as /data/)
/outputs/
/outputs/**/*

# Notebook run artifacts dropped beside notebooks
/notebooks/data/

# Cache and temporary files
.pytest_cache/
__pycache__/
*.pyc
*.pyo
.DS_Store
.playwright-mcp/

# Research data and analysis
*.pdf
*.docx
*.tif
*.tiff
/data/research/
/data/research/**/*

# Jupyter notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

